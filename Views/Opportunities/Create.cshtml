@model Opportunity
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card p-4">
            <div class="crm-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-primary me-2"></i>Create New Opportunity</h4>
                    <span class="text-muted small">Specify deal potential, sales stage, and expected closing schedule</span>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OpportunityName" class="form-label fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control" placeholder="Enterprise Software License" />
                        <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold">Select Customer <span class="text-danger">*</span></label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                            <option value="">-- Choose Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label fw-semibold">Deal Amount ($) <span class="text-danger">*</span></label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stage" class="form-label fw-semibold">Sales Stage <span class="text-danger">*</span></label>
                        <select asp-for="Stage" class="form-select" id="stageSelect">
                            <option value="Qualification">Qualification (10%)</option>
                            <option value="Proposal">Proposal (40%)</option>
                            <option value="Negotiation">Negotiation (75%)</option>
                            <option value="Won">Won (100%)</option>
                            <option value="Lost">Lost (0%)</option>
                        </select>
                        <span asp-validation-for="Stage" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Probability" class="form-label fw-semibold">Win Probability (%) <span class="text-danger">*</span></label>
                        <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                        <span asp-validation-for="Probability" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedCloseDate" class="form-label fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold">Associated Lead (Optional)</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                            <option value="">-- None --</option>
                        </select>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold">Assigned Sales Executive</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.AssignedTo">
                                <option value="">-- Assign Representative --</option>
                            </select>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label fw-semibold">Internal Notes & Scope</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key decision makers, requirements, timeline..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Save Opportunity
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('stageSelect').addEventListener('change', function () {
            const probInput = document.querySelector('input[name="Probability"]');
            switch (this.value) {
                case 'Qualification': probInput.value = 20; break;
                case 'Proposal': probInput.value = 50; break;
                case 'Negotiation': probInput.value = 80; break;
                case 'Won': probInput.value = 100; break;
                case 'Lost': probInput.value = 0; break;
            }
        });
    </script>
}
