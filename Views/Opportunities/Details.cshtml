@model Opportunity
@{
    ViewData["Title"] = "Opportunity Details - " + Model.OpportunityName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up-arrow text-primary me-2"></i>@Model.OpportunityName</h3>
        <span class="badge bg-primary">@Model.Stage</span> &bull;
        <span class="badge @(Model.Status == "Won" ? "bg-success" : (Model.Status == "Lost" ? "bg-danger" : "bg-warning text-dark"))">@Model.Status</span> &bull;
        <span class="text-muted small">Managed by @(Model.AssignedToUser?.FullName ?? "Unassigned")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Opportunity
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card crm-card p-4 h-100">
            <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Financial & Probability Metrics</h5>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="text-muted small">Contract Amount</div>
                    <div class="fs-3 fw-bold text-success">$@Model.Amount.ToString("N0")</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Win Probability</div>
                    <div class="fs-3 fw-bold text-primary">@Model.Probability%</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Weighted Pipeline</div>
                    <div class="fs-4 fw-bold text-dark">$@Model.WeightedValue.ToString("N0")</div>
                    <small class="text-muted">(Amount &times; Probability / 100)</small>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">Expected Close Date</div>
                    <div class="fs-5 fw-bold text-dark">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card crm-card p-4 h-100">
            <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Deal Information</h5>
            <div class="mb-2">
                <strong class="text-muted small d-block">Related Customer:</strong>
                @if (Model.Customer != null)
                {
                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-bold text-decoration-none">
                        @Model.Customer.CustomerName
                    </a>
                }
            </div>
            @if (Model.Lead != null)
            {
                <div class="mb-2">
                    <strong class="text-muted small d-block">Originating Lead:</strong>
                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId" class="text-decoration-none">
                        @Model.Lead.LeadName (@Model.Lead.LeadCode)
                    </a>
                </div>
            }
            <div class="mb-2">
                <strong class="text-muted small d-block">Notes:</strong>
                <p class="text-muted mb-0">@(Model.Notes ?? "No notes provided.")</p>
            </div>
            <div class="mb-2">
                <strong class="text-muted small d-block">Created On:</strong>
                <span>@Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
        </div>
    </div>
</div>
