@model Lead
@{
    ViewData["Title"] = "Lead Profile - " + Model.LeadName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel text-primary me-2"></i>@Model.LeadName</h3>
        <span class="badge bg-light text-dark border">@Model.LeadCode</span> &bull;
        <span class="badge bg-info text-dark">@Model.Status</span> &bull;
        <span class="text-muted small">Managed by @(Model.AssignedToUser?.FullName ?? "Unassigned")</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer / Deal
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Lead
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-outline-info btn-sm">
            <i class="bi bi-calendar-plus me-1"></i> Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card crm-card p-3 h-100">
            <h5 class="fw-bold text-secondary mb-3 border-bottom pb-2">Lead Information</h5>
            <div class="mb-2"><strong class="text-muted small d-block">Company:</strong> @(Model.CompanyName ?? "N/A")</div>
            <div class="mb-2"><strong class="text-muted small d-block">Email:</strong> <a href="mailto:@Model.Email">@Model.Email</a></div>
            <div class="mb-2"><strong class="text-muted small d-block">Phone:</strong> <a href="tel:@Model.Phone">@Model.Phone</a></div>
            <div class="mb-2"><strong class="text-muted small d-block">Lead Source:</strong> <span class="badge bg-light text-dark border">@Model.Source</span></div>
            <div class="mb-2"><strong class="text-muted small d-block">Expected Value:</strong> <span class="fw-bold text-success fs-5">$@Model.ExpectedValue.ToString("N0")</span></div>
            <div class="mb-2"><strong class="text-muted small d-block">Priority:</strong> <span class="badge bg-warning text-dark">@Model.Priority</span></div>
            <div class="mb-2"><strong class="text-muted small d-block">Captured On:</strong> @Model.CreatedDate.ToString("MMM dd, yyyy HH:mm")</div>
        </div>
    </div>

    <div class="col-lg-7">
        <!-- Scheduled Follow-ups -->
        <div class="card crm-card p-3 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold text-secondary mb-0"><i class="bi bi-calendar-check me-1"></i> Follow-Ups</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> Schedule
                </a>
            </div>
            @if (Model.FollowUps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FollowUps.OrderByDescending(f => f.FollowUpDate))
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@f.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0 py-2">No follow-ups recorded for this lead.</p>
            }
        </div>
    </div>
</div>
