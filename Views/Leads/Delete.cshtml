@model Lead
@{
    ViewData["Title"] = "Delete Lead";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <div class="card border-danger crm-card p-4">
            <div class="crm-header d-flex align-items-center text-danger border-bottom pb-3 mb-3">
                <i class="bi bi-exclamation-triangle-fill fs-2 me-2"></i>
                <div>
                    <h4 class="fw-bold mb-0">Confirm Lead Removal</h4>
                    <small class="text-muted">Review lead details before proceeding</small>
                </div>
            </div>

            <p class="text-muted">
                Are you sure you want to remove or archive lead <strong>@Model.LeadName</strong> (@Model.LeadCode)?
            </p>

            <dl class="row small mb-4">
                <dt class="col-sm-4 text-muted">Lead Name:</dt>
                <dd class="col-sm-8 fw-semibold">@Model.LeadName</dd>

                <dt class="col-sm-4 text-muted">Email:</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4 text-muted">Expected Value:</dt>
                <dd class="col-sm-8 text-success fw-bold">$@Model.ExpectedValue.ToString("N0")</dd>

                <dt class="col-sm-4 text-muted">Status:</dt>
                <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Status</span></dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.LeadId" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">
                        <i class="bi bi-trash me-1"></i> Yes, Remove Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
