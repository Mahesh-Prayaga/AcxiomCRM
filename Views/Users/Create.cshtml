@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-6">
        <div class="card crm-card p-4">
            <div class="crm-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>Add System User</h4>
                    <span class="text-muted small">Provision a new account with assigned role permissions</span>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Jane Smith" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Login Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="jane.smith@acxiomcrm.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold">Role <span class="text-danger">*</span></label>
                    <select asp-for="Role" class="form-select">
                        <option value="SalesExecutive">Sales Executive (Scoped to assigned records)</option>
                        <option value="Manager">Manager (Organization CRM pipeline & reports)</option>
                        <option value="Admin">Admin (Full administrative & security access)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Initial Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Min. 8 characters" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Activate account immediately</label>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Provision User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
