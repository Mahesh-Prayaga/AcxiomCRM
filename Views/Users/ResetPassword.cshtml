@model ResetUserPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5">
        <div class="card crm-card p-4">
            <div class="crm-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-key-fill text-primary me-2"></i>Reset User Password</h4>
                    <span class="text-muted small">Account: @Model.Email</span>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="Min. 8 characters" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
