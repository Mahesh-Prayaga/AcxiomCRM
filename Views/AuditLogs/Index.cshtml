@model IEnumerable<AuditLog>
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history text-primary me-2"></i>System Audit Trail</h3>
        <span class="text-muted small">Append-only compliance log tracking security events and CRM modifications</span>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">User / Email</label>
            <input type="text" name="userId" value="@ViewData["UserId"]" class="form-control form-control-sm" placeholder="User or email..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Action</label>
            <input type="text" name="action" value="@ViewData["Action"]" class="form-control form-control-sm" placeholder="Login, Create, Update..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Entity / Module</label>
            <select name="entityName" class="form-select form-select-sm">
                <option value="">All Entities</option>
                <option value="Customer" selected="@(ViewData["EntityName"]?.ToString() == "Customer")">Customer</option>
                <option value="Lead" selected="@(ViewData["EntityName"]?.ToString() == "Lead")">Lead</option>
                <option value="Opportunity" selected="@(ViewData["EntityName"]?.ToString() == "Opportunity")">Opportunity</option>
                <option value="FollowUp" selected="@(ViewData["EntityName"]?.ToString() == "FollowUp")">FollowUp</option>
                <option value="Activity" selected="@(ViewData["EntityName"]?.ToString() == "Activity")">Activity</option>
                <option value="Security" selected="@(ViewData["EntityName"]?.ToString() == "Security")">Security</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">From Date</label>
            <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">To Date</label>
            <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-search me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card crm-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Module</th>
                    <th>Record ID</th>
                    <th>Audit Details / Change Record</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@(a.UserName ?? a.UserId ?? "System")</td>
                            <td>
                                @if (a.Action == "Login")
                                {
                                    <span class="badge bg-success">Login</span>
                                }
                                else if (a.Action.Contains("Failed"))
                                {
                                    <span class="badge bg-danger">Failed Login</span>
                                }
                                else if (a.Action == "Create")
                                {
                                    <span class="badge bg-primary">Create</span>
                                }
                                else if (a.Action == "Update")
                                {
                                    <span class="badge bg-info text-dark">Update</span>
                                }
                                else if (a.Action == "Delete" || a.Action == "Deactivate")
                                {
                                    <span class="badge bg-warning text-dark">@a.Action</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@a.Action</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@a.EntityName</span></td>
                            <td>@(a.RecordId ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.OldValue))
                                {
                                    <div class="text-danger small"><del>@a.OldValue</del></div>
                                }
                                @if (!string.IsNullOrEmpty(a.NewValue))
                                {
                                    <div class="text-dark">@a.NewValue</div>
                                }
                            </td>
                            <td class="text-muted">@(a.IpAddress ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No audit records found matching criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
