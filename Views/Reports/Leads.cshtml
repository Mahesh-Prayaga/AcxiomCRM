@model IEnumerable<LeadReportItem>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel text-primary me-2"></i>Lead Generation & Source Report</h3>
        <span class="text-muted small">Channel effectiveness, conversion status, and prospect pipeline</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
</div>

<div class="card crm-card p-3 mb-4">
    <form method="get" asp-action="Leads" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Source</label>
            <select name="source" class="form-select form-select-sm">
                <option value="">All Sources</option>
                <option value="Website">Website</option>
                <option value="Referral">Referral</option>
                <option value="Cold Call">Cold Call</option>
                <option value="Trade Show">Trade Show</option>
                <option value="Email Campaign">Email Campaign</option>
                <option value="Social Media">Social Media</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="New">New</option>
                <option value="Contacted">Contacted</option>
                <option value="Qualified">Qualified</option>
                <option value="Converted">Converted</option>
                <option value="Lost">Lost</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
        </div>
    </form>
</div>

<div class="card crm-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Lead Code</th>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Expected Value</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@l.LeadCode</span></td>
                        <td class="fw-semibold">@l.LeadName</td>
                        <td>@(l.CompanyName ?? "-")</td>
                        <td><span class="badge bg-light text-dark border">@l.Source</span></td>
                        <td class="fw-bold text-success">$@l.ExpectedValue.ToString("N0")</td>
                        <td>
                            <span class="badge @(l.Status == "Converted" ? "bg-success" : (l.Status == "Qualified" ? "bg-info text-dark" : "bg-secondary"))">
                                @l.Status
                            </span>
                        </td>
                        <td>@l.OwnerName</td>
                        <td>@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
