@model IEnumerable<UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill text-primary me-2"></i>Sales Team Activity Report</h3>
        <span class="text-muted small">Comparative productivity metrics per representative</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
</div>

<div class="card crm-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Team Member</th>
                    <th>Role</th>
                    <th class="text-center">Total Activities</th>
                    <th class="text-center">Calls</th>
                    <th class="text-center">Meetings</th>
                    <th class="text-center">Emails</th>
                    <th class="text-center">Tasks</th>
                    <th class="text-center">Follow-Ups Handled</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.UserName</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (u.Role == "Manager")
                            {
                                <span class="badge bg-warning text-dark">Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">SalesExecutive</span>
                            }
                        </td>
                        <td class="text-center fw-bold fs-5 text-primary">@u.TotalActivities</td>
                        <td class="text-center"><span class="badge bg-light text-dark border">@u.CallsCount</span></td>
                        <td class="text-center"><span class="badge bg-light text-dark border">@u.MeetingsCount</span></td>
                        <td class="text-center"><span class="badge bg-light text-dark border">@u.EmailsCount</span></td>
                        <td class="text-center"><span class="badge bg-light text-dark border">@u.TasksCount</span></td>
                        <td class="text-center fw-bold text-success">@u.FollowUpsHandled</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
