@model ConversionReportViewModel
@{
    ViewData["Title"] = "Lead Conversion Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-arrow-repeat text-primary me-2"></i>Lead-to-Customer Conversion Report</h3>
        <span class="text-muted small">Tracking qualification efficiency and customer acquisition performance</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
</div>

<!-- Conversion Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-primary border-4">
            <div class="text-muted small fw-semibold text-uppercase">Total Captured Leads</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalLeads</div>
            <div class="small text-muted mt-1">Cumulative prospect pipeline</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-success border-4">
            <div class="text-muted small fw-semibold text-uppercase">Converted to Accounts</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.ConvertedLeads</div>
            <div class="small text-muted mt-1">Won customer accounts</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-info border-4">
            <div class="text-muted small fw-semibold text-uppercase">Conversion Rate</div>
            <div class="fs-2 fw-bold text-info mt-1">@Model.ConversionRate%</div>
            <div class="small text-muted mt-1">Converted &divide; Total Leads</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-warning border-4">
            <div class="text-muted small fw-semibold text-uppercase">In-Funnel Leads</div>
            <div class="fs-2 fw-bold text-warning mt-1">@Model.OpenLeads</div>
            <div class="small text-muted mt-1">Active prospects still qualifying</div>
        </div>
    </div>
</div>

<!-- Converted Leads Table -->
<div class="card crm-card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold text-secondary mb-0">Successfully Converted Customer Accounts</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Lead Code</th>
                    <th>Prospect Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Source Channel</th>
                    <th>Estimated Value</th>
                    <th>Representative</th>
                    <th>Creation Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ConvertedList.Any())
                {
                    @foreach (var c in Model.ConvertedList)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.LeadCode</span></td>
                            <td class="fw-semibold">@c.LeadName</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.Email</td>
                            <td><span class="badge bg-light text-dark border">@c.Source</span></td>
                            <td class="fw-bold text-success">$@c.ExpectedValue.ToString("N0")</td>
                            <td>@c.OwnerName</td>
                            <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No converted leads recorded yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
