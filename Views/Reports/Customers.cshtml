@model IEnumerable<CustomerReportItem>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-people text-primary me-2"></i>Customer Intelligence Report</h3>
        <span class="text-muted small">Account master directory, assignment breakdown, and status distribution</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
</div>

<div class="card crm-card p-3 mb-4">
    <form method="get" asp-action="Customers" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewData["Status"]?.ToString() == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewData["Status"]?.ToString() == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
        </div>
    </form>
</div>

<div class="card crm-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Representative</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                        <td class="fw-semibold">@c.CustomerName</td>
                        <td>@(c.CompanyName ?? "-")</td>
                        <td>@c.Email</td>
                        <td>@c.Phone</td>
                        <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                        <td><span class="badge bg-primary">@c.OwnerName</span></td>
                        <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
