@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 border-0 shadow-sm crm-card">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="text-danger fw-bold">Access Denied (403)</h2>
            <p class="text-muted mt-2">
                You do not have the required role or ownership permissions to view or modify this CRM resource.
            </p>
            <div class="mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
