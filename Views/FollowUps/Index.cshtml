@model IEnumerable<FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-check text-primary me-2"></i>Follow-Ups & Reminders</h3>
        <span class="text-muted small">Schedule, reschedule, and complete scheduled touchpoints</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Date</label>
            <input type="date" name="date" value="@ViewData["Date"]" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Planned" selected="@(ViewData["Status"]?.ToString() == "Planned")">Planned</option>
                <option value="Completed" selected="@(ViewData["Status"]?.ToString() == "Completed")">Completed</option>
                <option value="Missed" selected="@(ViewData["Status"]?.ToString() == "Missed")">Missed</option>
                <option value="Cancelled" selected="@(ViewData["Status"]?.ToString() == "Cancelled")">Cancelled</option>
            </select>
        </div>
        @if (ViewBag.UsersList != null)
        {
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Assigned User</label>
                <select name="assignedTo" class="form-select form-select-sm" asp-items="ViewBag.UsersList">
                    <option value="">All Users</option>
                </select>
            </div>
        }
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-search me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card crm-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Scheduled Date</th>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Associated With</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var f in Model)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate.Date < DateTime.Today;
                        <tr class="@(isOverdue ? "table-danger bg-opacity-25" : "")">
                            <td>
                                <span class="fw-semibold">@f.FollowUpDate.ToString("yyyy-MM-dd")</span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                            <td class="fw-semibold">@f.Subject</td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">
                                        <i class="bi bi-person me-1"></i>@f.Customer.CustomerName
                                    </a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none text-info">
                                        <i class="bi bi-funnel me-1"></i>@f.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(f.AssignedToUser?.FullName ?? "Unassigned")</td>
                            <td>
                                @if (f.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (f.Status == "Missed")
                                {
                                    <span class="badge bg-danger">Missed</span>
                                }
                                else if (f.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Planned</span>
                                }
                            </td>
                            <td class="small text-muted">@(f.Remarks ?? "-")</td>
                            <td class="text-end">
                                @if (f.Status == "Planned")
                                {
                                    <!-- Complete Action Form -->
                                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@f.FollowUpId" title="Mark Completed">
                                        <i class="bi bi-check-lg"></i>
                                    </button>

                                    <!-- Reschedule Action Button -->
                                    <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId" title="Reschedule">
                                        <i class="bi bi-clock-history"></i>
                                    </button>
                                }

                                <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>

                                <!-- Complete Modal -->
                                <div class="modal fade text-start" id="completeModal-@f.FollowUpId" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Complete Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-2">Mark follow-up <strong>@f.Subject</strong> as completed?</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Outcome / Notes</label>
                                                        <textarea name="remarks" class="form-control form-control-sm" rows="3" placeholder="Summary of conversation, action items..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success">Mark Completed</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade text-start" id="rescheduleModal-@f.FollowUpId" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Reschedule" asp-route-id="@f.FollowUpId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Reschedule Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">New Follow-Up Date</label>
                                                        <input type="date" name="newDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Reason for Rescheduling</label>
                                                        <input type="text" name="remarks" class="form-control form-control-sm" placeholder="Client requested later time..." />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-warning">Save New Schedule</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No follow-ups found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
