@model Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card crm-card p-4">
            <div class="crm-header d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-plus text-primary me-2"></i>Log CRM Activity</h4>
                    <span class="text-muted small">Record phone discussions, presentations, emails, or tasks</span>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label fw-semibold">Activity Type <span class="text-danger">*</span></label>
                        <select asp-for="ActivityType" class="form-select">
                            <option value="Call">Phone Call</option>
                            <option value="Meeting">Meeting / Presentation</option>
                            <option value="Email">Email Communication</option>
                            <option value="Task">Sales Task</option>
                        </select>
                        <span asp-validation-for="ActivityType" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Subject" class="form-label fw-semibold">Subject / Title <span class="text-danger">*</span></label>
                        <input asp-for="Subject" class="form-control" placeholder="Contract discussion call" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityDate" class="form-label fw-semibold">Date & Time <span class="text-danger">*</span></label>
                        <input asp-for="ActivityDate" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Planned">Planned</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label fw-semibold">Associate Customer (Optional)</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId">
                            <option value="">-- None --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label fw-semibold">Associate Lead (Optional)</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadId">
                            <option value="">-- None --</option>
                        </select>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label fw-semibold">Performed By</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.AssignedTo">
                                <option value="">-- Assign Representative --</option>
                            </select>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">Detailed Notes / Minutes</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Key outcomes, requirements discussed, next steps..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Save Activity
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
