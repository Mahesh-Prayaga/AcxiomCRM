@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customer Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-people text-primary me-2"></i>Customers</h3>
        <span class="text-muted small">Manage account masters, contact info, and customer history</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Add Customer
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card crm-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Customer Name</label>
            <input type="text" name="searchName" value="@ViewData["SearchName"]" class="form-control form-control-sm" placeholder="Search by name..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Email</label>
            <input type="text" name="searchEmail" value="@ViewData["SearchEmail"]" class="form-control form-control-sm" placeholder="Email..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Phone</label>
            <input type="text" name="searchPhone" value="@ViewData["SearchPhone"]" class="form-control form-control-sm" placeholder="Phone..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-semibold text-muted">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewData["Status"]?.ToString() == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewData["Status"]?.ToString() == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-search me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card crm-card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Contact Info</th>
                    <th>Company</th>
                    <th>City/State</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td class="fw-semibold">
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="text-decoration-none">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope me-1 text-muted small"></i>@c.Email</div>
                                <div><i class="bi bi-telephone me-1 text-muted small"></i>@c.Phone</div>
                            </td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.City @(string.IsNullOrEmpty(c.State) ? "" : $", {c.State}")</td>
                            <td>
                                <span class="badge bg-secondary">@(c.AssignedToUser?.FullName ?? "Unassigned")</span>
                            </td>
                            <td>
                                @if (c.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No customers found matching the search criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
