@model DashboardViewModel
@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-speedometer2 text-primary me-2"></i>Sales & Pipeline Dashboard</h2>
        <span class="text-muted small">
            <i class="bi bi-shield-check me-1"></i> Active Role: <strong>@Model.UserRole</strong> &bull; @Model.ScopeDescription
        </span>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Customers" asp-action="Create" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i> New Customer
        </a>
        <a asp-controller="Leads" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-funnel me-1"></i> New Lead
        </a>
        <a asp-controller="Opportunities" asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle me-1"></i> New Deal
        </a>
    </div>
</div>

<!-- KPI Cards Row 1 -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Customers</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalCustomers</div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
            <div class="mt-2 text-muted small">
                <a asp-controller="Customers" asp-action="Index" class="text-decoration-none">View directory &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Total Leads</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalLeads</div>
                </div>
                <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                    <i class="bi bi-funnel fs-4"></i>
                </div>
            </div>
            <div class="mt-2 text-muted small">
                <span class="badge bg-warning text-dark">@Model.OpenLeads Open</span> leads currently
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Open Deals</div>
                    <div class="fs-3 fw-bold text-dark">@Model.OpenOpportunities</div>
                </div>
                <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
            <div class="mt-2 text-muted small">
                Total @Model.TotalOpportunities opportunities in scope
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card crm-card p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Pipeline Value</div>
                    <div class="fs-3 fw-bold text-success">$@Model.TotalPipelineValue.ToString("N0")</div>
                </div>
                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
            <div class="mt-2 text-muted small">
                Active pipeline potential
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards Row 2 -->
<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="card crm-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Won Opportunities</div>
                    <div class="fs-4 fw-bold text-success">@Model.WonOpportunities</div>
                </div>
                <i class="bi bi-trophy text-success fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card crm-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Lost Opportunities</div>
                    <div class="fs-4 fw-bold text-secondary">@Model.LostOpportunities</div>
                </div>
                <i class="bi bi-x-circle text-secondary fs-3"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card crm-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Pending Follow-Ups</div>
                    <div class="fs-4 fw-bold text-primary">@Model.PendingFollowUps</div>
                </div>
                <i class="bi bi-calendar-event text-primary fs-3"></i>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card crm-card h-100 p-3">
            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-pie-chart me-1"></i> Lead Status Distribution</h6>
            <div style="height: 260px; position: relative;">
                <canvas id="leadStatusChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card crm-card h-100 p-3">
            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-bar-chart me-1"></i> Opportunity Pipeline by Stage</h6>
            <div style="height: 260px; position: relative;">
                <canvas id="pipelineStageChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card crm-card h-100 p-3">
            <h6 class="fw-bold mb-3 text-secondary"><i class="bi bi-graph-up me-1"></i> Monthly Won Revenue Trend</h6>
            <div style="height: 260px; position: relative;">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Records Lists -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-secondary mb-0"><i class="bi bi-calendar-check me-1"></i> Upcoming Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-outline-secondary btn-sm">All Follow-ups</a>
            </div>
            @if (Model.UpcomingFollowUps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Subject</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.UpcomingFollowUps)
                            {
                                <tr>
                                    <td class="fw-semibold">@f.Subject</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td>@f.FollowUpDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-warning text-dark">@f.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small my-3 text-center">No upcoming planned follow-ups.</p>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card crm-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-secondary mb-0"><i class="bi bi-fire me-1"></i> Top Active Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-outline-secondary btn-sm">View Pipeline</a>
            </div>
            @if (Model.TopOpportunities.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Opportunity</th>
                                <th>Customer</th>
                                <th>Stage</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opp in Model.TopOpportunities)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="text-decoration-none">
                                            @opp.OpportunityName
                                        </a>
                                    </td>
                                    <td>@opp.Customer?.CustomerName</td>
                                    <td><span class="badge bg-primary">@opp.Stage</span></td>
                                    <td class="fw-bold text-success">$@opp.Amount.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small my-3 text-center">No active open opportunities.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Chart 1: Lead Status
        const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
        new Chart(leadCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts)),
                    backgroundColor: ['#0d6efd', '#0dcaf0', '#198754', '#6c757d', '#ffc107']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Chart 2: Pipeline Stage
        const stageCtx = document.getElementById('pipelineStageChart').getContext('2d');
        new Chart(stageCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageLabels)),
                datasets: [{
                    label: 'Amount ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineStageAmounts)),
                    backgroundColor: '#0d6efd'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                },
                plugins: { legend: { display: false } }
            }
        });

        // Chart 3: Monthly Sales
        const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
        new Chart(salesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesLabels)),
                datasets: [{
                    label: 'Revenue Won ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesAmounts)),
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}
